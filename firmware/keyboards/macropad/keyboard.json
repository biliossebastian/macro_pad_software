{
    "manufacturer": "Silios",
    "keyboard_name": "macropad",
    "maintainer": "silios",
    "processor": "RP2040",
    "bootloader": "rp2040",
    "board": "GENERIC_RP_RP2040",
    "usb": {
        "vid": "0xFEED",
        "pid": "0x0001",
        "device_version": "0.0.1"
    },
    "features": {
        "bootmagic": true,
        "console": true,
        "encoder": true,
        "extrakey": true,
        "rgblight": true
    },
    "ws2812": {
        "driver": "vendor",
        "pin": "GP24"
    },
    "rgblight": {
        "led_count": 9,
        "max_brightness": 120,
        "animations": {
            "rainbow_swirl": true
        },
        "default": {
            "animation": "rainbow_swirl",
            "hue": 0,
            "sat": 255,
            "val": 120
        }
    },
    "diode_direction": "COL2ROW",
