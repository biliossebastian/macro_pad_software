        "cols": ["GP0", "GP1", "GP2"],
        "rows": ["GP3", "GP4", "GP5", "GP11"]
    },
    "encoder": {
        "rotary": [
            {"pin_a": "GP15", "pin_b": "GP16"},
            {"pin_a": "GP17", "pin_b": "GP18"},
            {"pin_a": "GP19", "pin_b": "GP20"}
        ]
    },
    "layouts": {
        "LAYOUT": {
            "layout": [
                {"matrix": [0, 0], "x": 0, "y": 0},
                {"matrix": [0, 1], "x": 1, "y": 0},
                {"matrix": [0, 2], "x": 2, "y": 0},
                {"matrix": [1, 0], "x": 0, "y": 1},
                {"matrix": [1, 1], "x": 1, "y": 1},
                {"matrix": [1, 2], "x": 2, "y": 1},
                {"matrix": [2, 0], "x": 0, "y": 2},
                {"matrix": [2, 1], "x": 1, "y": 2},
                {"matrix": [2, 2], "x": 2, "y": 2},
                {"matrix": [3, 0], "x": 0, "y": 3.5},
                {"matrix": [3, 1], "x": 1, "y": 3.5},
                {"matrix": [3, 2], "x": 2, "y": 3.5}
            ]
        }
    }
}
